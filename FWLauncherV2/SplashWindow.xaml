<Window x:Class="FWLauncherV2.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Width="640" Height="520" Topmost="True">
    <Grid>
        <!-- Merkez logo bloğu -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- LOGO — parlama + yanıp sönme (opacity pulse) -->
            <Grid Width="360" Height="360">
                <!-- Arka parlama halesi -->
                <Ellipse x:Name="Glow" Width="340" Height="340" Opacity="0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66FFCB05" Offset="0"/>
                            <GradientStop Color="#00FFCB05" Offset="0.7"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="40"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Asıl logo -->
                <Image x:Name="Logo" Source="pack://application:,,,/PokeWingLauncher.png"
                       Width="300" Height="300" Opacity="0"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.7" ScaleY="0.7"/>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect x:Name="LogoGlow" Color="#FFCB05" BlurRadius="0" ShadowDepth="0" Opacity="0.9"/>
                    </Image.Effect>
                </Image>

                <!-- YANSIMA (reflection) — logonun aynası, alta doğru solan -->
                <Image Source="pack://application:,,,/PokeWingLauncher.png"
                       Width="300" Height="300" Opacity="0.18"
                       VerticalAlignment="Bottom" Margin="0,300,0,-260"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleY="-1"/>
                    </Image.RenderTransform>
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#66000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.6"/>
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
            </Grid>

            <!-- Marka adı -->
            <TextBlock x:Name="BrandText" Text="P O K E W I N G" FontSize="30" FontWeight="Bold"
                       Foreground="#FFCB05" HorizontalAlignment="Center" Opacity="0"
                       Margin="0,-40,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#F5A300" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Durum + ince yükleme çizgisi -->
            <TextBlock x:Name="StatusText" Text="Bütünlük doğrulanıyor..." FontSize="13"
                       Foreground="#AAFFFFFF" HorizontalAlignment="Center" Margin="0,14,0,0" Opacity="0"/>

            <Border x:Name="BarTrack" Width="220" Height="3" CornerRadius="2" Margin="0,14,0,0"
                    Background="#22FFFFFF" Opacity="0">
                <Border x:Name="BarFill" Width="0" Height="3" CornerRadius="2" HorizontalAlignment="Left"
                        Background="#FFCB05"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
