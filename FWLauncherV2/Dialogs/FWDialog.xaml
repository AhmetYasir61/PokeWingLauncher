<Window x:Class="FWLauncherV2.Dialogs.FWDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokeWingLauncher"
        SizeToContent="Height"
        Width="440"
        MinHeight="170"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Opacity="0"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="Root" Margin="14" CornerRadius="18" Background="{StaticResource WindowBackdrop}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ScaleT" ScaleX="0.94" ScaleY="0.94"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER (icon + title) — sürüklenebilir -->
            <Grid Grid.Row="0" Background="Transparent" MouseDown="Header_MouseDown" Margin="22,20,14,0">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IconCircle" Width="44" Height="44" CornerRadius="22"
                            Background="{StaticResource AccentSoftBrush}">
                        <TextBlock x:Name="IconGlyph" Text="i"
                                   FontFamily="{StaticResource UiFont}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtTitle" Text="Başlık"
                               Style="{StaticResource H2}" FontSize="17"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <Button x:Name="BtnClose" Content="&#x2715;" Style="{StaticResource ChromeCloseButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnClose_Click"/>
            </Grid>

            <!-- MESSAGE -->
            <TextBlock x:Name="TxtMessage" Grid.Row="1" Text="Mesaj"
                       Margin="24,16,24,6" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13.5" LineHeight="21"/>

            <!-- BUTTONS -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="22,16,18,18">
                <Button x:Name="BtnCancel" Content="İptal" MinWidth="92" Height="40"
                        Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                        Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnSecondary" Content="Hayır" MinWidth="92" Height="40"
                        Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                        Margin="0,0,10,0" Click="BtnSecondary_Click"/>
                <Button x:Name="BtnPrimary" Content="Tamam" MinWidth="112" Height="40"
                        Style="{StaticResource PrimaryButton}" Click="BtnPrimary_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
