<Window x:Class="FWLauncherV2.Dialogs.TransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coin Gönder"
        SizeToContent="Height"
        Width="430"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border Margin="14" CornerRadius="18" Background="{StaticResource WindowBackdrop}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel Margin="24,20,24,20">
            <Grid MouseDown="Header_MouseDown" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="↑" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Coin Gönder" Style="{StaticResource H2}" FontSize="17" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <Button Content="&#x2715;" Style="{StaticResource ChromeCloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Cancel_Click"/>
            </Grid>

            <TextBlock x:Name="TxtHint" Text="Bir oyuncuya coin gönder." Style="{StaticResource Caption}" Margin="0,12,0,16"/>

            <TextBlock Text="Kullanıcı Adı" Style="{StaticResource Label}" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtUser" Style="{StaticResource FWTextBox}" Margin="0,0,0,14"/>

            <TextBlock Text="Miktar (Coin)" Style="{StaticResource Label}" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtAmount" Style="{StaticResource FWTextBox}"/>

            <Border x:Name="ErrorBox" Visibility="Collapsed" Background="#1AEF4444" BorderBrush="#55EF4444"
                    BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,14,0,0">
                <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           FontSize="12.5" FontWeight="SemiBold"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="İptal" MinWidth="92" Height="42" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="BtnSend" Content="Gönder" MinWidth="120" Height="42" Style="{StaticResource PrimaryButton}" Click="Send_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
