<Window x:Class="FWLauncherV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FWLauncherV2.Views"
        Title="PokeWingLauncher"
        Width="1300"
        Height="800"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        StateChanged="Window_StateChanged"
        Background="Transparent">

    <Border x:Name="RootBorder" Margin="16" CornerRadius="20" Background="{StaticResource WindowBackdrop}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.65"/>
        </Border.Effect>

        <Border x:Name="InnerBorder" CornerRadius="20" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===================== TITLE BAR ===================== -->
                <Grid Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="244"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                        <Image Source="/PokeWingLauncher.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#FFFFD21E" Opacity="0.6"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="PokeWingLauncher" VerticalAlignment="Center" Margin="11,0,0,0"
                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtPageTitle" Grid.Column="1" Text="Ana Sayfa" VerticalAlignment="Center"
                               Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Content="&#x2012;" FontSize="16" Style="{StaticResource ChromeButton}" Click="MinimizeButton_Click"/>
                        <Button x:Name="BtnMaximize" Content="&#x25A1;" FontSize="15" Style="{StaticResource ChromeButton}"
                                ToolTip="Tam ekran / Geri al" Click="MaximizeButton_Click"/>
                        <Button Content="&#x2715;" Style="{StaticResource ChromeCloseButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ===================== BODY ===================== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="244"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="376"/>
                    </Grid.ColumnDefinitions>

                    <!-- SIDEBAR -->
                    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,8,0,0">
                                <TextBlock Text="MENÜ" Margin="26,0,0,8" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>

                                <Button x:Name="NavHome" Style="{StaticResource NavItem}" Margin="12,2" Click="NavHome_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="28" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ana Sayfa" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavReklam" Style="{StaticResource NavItem}" Margin="12,2" Click="NavReklam_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE789;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="28" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reklamlar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavDestek" Style="{StaticResource NavItem}" Margin="12,2" Click="NavDestek_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="28" VerticalAlignment="Center"/>
                                        <TextBlock Text="Destek" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavMods" Style="{StaticResource NavItem}" Margin="12,2" Click="NavMods_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="28" VerticalAlignment="Center"/>
                                        <TextBlock Text="Dosyalar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavSettings" Style="{StaticResource NavItem}" Margin="12,2" Click="NavSettings_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="28" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ayarlar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Yalnızca owner/admin için görünür -->
                                <Button x:Name="NavAdmin" Style="{StaticResource NavItem}" Margin="12,2" Click="NavAdmin_Click" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="28"
                                                   VerticalAlignment="Center" Foreground="{StaticResource AccentAmberBrush}"/>
                                        <TextBlock Text="Kontrol Paneli" VerticalAlignment="Center" Foreground="{StaticResource AccentAmberBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- FOOTER -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                <!-- COIN BAKİYESİ -->
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="13"
                                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1"
                                        Padding="12,9" Margin="12,0,12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="BAKİYE" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtCoins" Text="0 Coin" Foreground="{StaticResource AccentAmberBrush}"
                                                       FontWeight="Bold" FontSize="16"/>
                                        </StackPanel>
                                        <Button x:Name="BtnTransfer" Grid.Column="1" Content="Gönder" Height="32" MinWidth="74"
                                                Style="{StaticResource SecondaryButton}" Click="BtnTransfer_Click"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="13"
                                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1"
                                        Padding="10" Margin="12,0,12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentGradient}">
                                            <TextBlock x:Name="TxtUserInitial" Text="O" Foreground="#FF161616" FontWeight="Bold" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSidebarUser" Text="Oyuncu" FontWeight="SemiBold" FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource OnlineBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Çevrimiçi" Margin="6,0,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Button x:Name="BtnLogout" Style="{StaticResource NavItem}" Margin="12,0" Click="BtnLogout_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28"
                                                   VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}"/>
                                        <TextBlock Text="Çıkış Yap" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CENTER CONTENT -->
                    <Grid Grid.Column="1" Margin="22,4,16,20">
                        <ContentControl x:Name="CenterContent"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                    </Grid>

                    <!-- RIGHT: PERSISTENT PLAY CARD -->
                    <Grid Grid.Column="2" Margin="0,4,20,20">
                        <views:MainView x:Name="PlayCard"/>
                    </Grid>
                </Grid>

                <!-- ===================== MODERASYON KİLİT EKRANI ===================== -->
                <Border x:Name="ModOverlay" Grid.Row="1" Visibility="Collapsed" Background="#F4070A16">
                    <Border Style="{StaticResource Card}" Width="540" Padding="44" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtModIcon" Text="⛔" FontSize="60" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtModTitle" Text="Hesabın yasaklandı" Style="{StaticResource Display}" FontSize="27"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock x:Name="TxtModMsg" Text="" Style="{StaticResource Caption}" FontSize="14"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="440"/>
                            <TextBlock x:Name="TxtModTimer" Text="" Foreground="{StaticResource AccentAmberBrush}" FontSize="24" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
