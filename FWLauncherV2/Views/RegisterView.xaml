<UserControl x:Class="FWLauncherV2.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid VerticalAlignment="Center">
        <StackPanel Width="330" HorizontalAlignment="Center">

            <TextBlock Text="POKEWING'E KATIL"
                       Foreground="{StaticResource AccentAmberBrush}"
                       FontSize="12" FontWeight="Bold"/>

            <TextBlock Text="Hesap Oluştur"
                       Style="{StaticResource Display}"
                       Margin="0,4,0,4"/>

            <TextBlock Text="Birkaç saniyede ücretsiz hesabını oluştur."
                       Style="{StaticResource Caption}"
                       Margin="0,0,0,20"/>

            <!-- ERROR -->
            <Border x:Name="ErrorBox" Visibility="Collapsed"
                    Background="#1AEF4444" BorderBrush="#55EF4444" BorderThickness="1"
                    CornerRadius="10" Padding="12,9" Margin="0,0,0,14">
                <TextBlock x:Name="TxtErrorMessage"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold"/>
            </Border>

            <TextBlock Text="Kullanıcı Adı" Style="{StaticResource Label}" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtUsername" Style="{StaticResource FWTextBox}" Margin="0,0,0,12"/>

            <TextBlock Text="E-posta" Style="{StaticResource Label}" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtEmail" Style="{StaticResource FWTextBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Şifre" Style="{StaticResource Label}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="TxtPassword" Style="{StaticResource FWPasswordBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Şifre (Tekrar)" Style="{StaticResource Label}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="TxtPasswordConfirm" Style="{StaticResource FWPasswordBox}" Margin="0,0,0,20"/>

            <Button x:Name="BtnRegister" Content="KAYIT OL"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnRegister_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="Zaten hesabın var mı?" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Content="Giriş Yap" Style="{StaticResource LinkButton}" Margin="6,0,0,0" Click="LoginButton_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
