<UserControl x:Class="FWLauncherV2.Views.ReklamlarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,14">
            <TextBlock Text="Reklamlar &amp; Duyurular" Style="{StaticResource Display}" FontSize="24"/>
            <TextBlock Text="Sunucudan haberler, etkinlikler ve kampanyalar." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AdsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,12" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                                BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                            <Grid Height="104">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="13,0,0,13" Background="{StaticResource SurfaceAltBrush}">
                                    <Image Source="{Binding DisplayImage}" Width="56" Height="56"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                    <Border Visibility="{Binding BadgeVisibility}" HorizontalAlignment="Left"
                                            Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,2" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Badge}" Foreground="{StaticResource AccentAmberBrush}"
                                                   FontSize="10.5" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="38"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Detay" Height="36" MinWidth="90" Margin="0,0,16,0"
                                        Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="Open_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
