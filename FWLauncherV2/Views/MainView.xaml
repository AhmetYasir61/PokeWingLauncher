<UserControl x:Class="FWLauncherV2.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Style="{StaticResource Card}" Padding="22,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- INFO -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="PackImage" Width="116" Height="116" HorizontalAlignment="Center"
                       Margin="0,0,0,16" Source="/PokeWingLauncher.png"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#FFFFD21E" Opacity="0.5"/>
                    </Image.Effect>
                </Image>

                <TextBlock x:Name="TxtWelcome" Text="Hoş geldin!" Style="{StaticResource Caption}"
                           Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="TxtPackName" Text="Yükleniyor..." Style="{StaticResource Display}"
                           FontSize="25" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,8"/>

                <!-- Sürüm/paket seçici: modpacks.json'daki tüm paketler (web editöründen yönetilir) -->
                <ComboBox x:Name="CmbPack" MinWidth="200" MaxWidth="250" HorizontalAlignment="Center"
                          Margin="0,0,0,12" Visibility="Collapsed"
                          SelectionChanged="CmbPack_SelectionChanged"/>

                <StackPanel x:Name="BadgesPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Padding="13,5">
                        <TextBlock x:Name="TxtLoaderBadge" Text="NeoForge"
                                   Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold" FontSize="12.5"/>
                    </Border>
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="9" Padding="13,5" Margin="8,0,0,0">
                        <TextBlock x:Name="TxtVersionBadge" Text="1.21.1"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12.5"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- SERVER STATUS -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="12" Padding="16,12" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="ServerDot" Grid.Column="0" Width="10" Height="10"
                             Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtServerStatus" Text="Sunucu durumu kontrol ediliyor..."
                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtServerIp" Text="" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource AccentSoftBrush}" CornerRadius="7"
                            Padding="9,4" VerticalAlignment="Center">
                        <TextBlock Text="Otomatik" Foreground="{StaticResource AccentAmberBrush}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- BUTTONS: GÜNCELLE + OYNA -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnUpdate" Grid.Column="0" Content="KUR" Width="112" Height="48"
                        Style="{StaticResource SecondaryButton}" Click="BtnUpdate_Click"/>
                <Button x:Name="BtnPlay" Grid.Column="1" Content="OYNA" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="BtnPlay_Click"/>
            </Grid>

            <!-- PROGRESS + STATUS -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"
                             Style="{StaticResource FWProgressBar}"/>
                <TextBlock x:Name="LblStatus" Text="Hazır" Style="{StaticResource Caption}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
