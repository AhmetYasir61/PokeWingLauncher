<UserControl x:Class="FWLauncherV2.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HERO -->
        <Border Grid.Row="0" CornerRadius="18" Margin="0,0,0,18" Height="200" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0C1330" Offset="0"/>
                    <GradientStop Color="#FF130E2C" Offset="0.55"/>
                    <GradientStop Color="#FF1C0F2E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <!-- Sol: mavi kanat parıltısı -->
                <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Margin="-70,0,0,0" Opacity="0.5" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#552F6BEE" Offset="0"/>
                            <GradientStop Color="#002F6BEE" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Sağ: altın parıltı + magenta tonu -->
                <Ellipse Width="340" Height="340" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,0,-60,0" Opacity="0.55" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55FFD21E" Offset="0"/>
                            <GradientStop Color="#22FF2E92" Offset="0.7"/>
                            <GradientStop Color="#00FF2E92" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Image Source="/PokeWingLauncher.png" Width="150" Height="150"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" Opacity="0.95">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#FFFFD21E" Opacity="0.5"/>
                    </Image.Effect>
                </Image>

                <StackPanel VerticalAlignment="Center" Margin="34,0,0,0">
                    <TextBlock x:Name="TxtHello" Text="Hoş geldin!" Foreground="{StaticResource AccentAmberBrush}"
                               FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="PokeWing Network" Style="{StaticResource Display}" FontSize="34" Margin="0,4,0,0"/>
                    <TextBlock Text="Tek tıkla kur, oyna ve sunucuya otomatik bağlan."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,6,0,16"/>
                    <Button Content="Duyuruları Gör" Width="170" Height="42"
                            HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="GoReklam_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- HIZLI ERİŞİM -->
        <TextBlock Grid.Row="1" Text="HIZLI ERİŞİM" Foreground="{StaticResource TextMutedBrush}"
                   FontSize="11" FontWeight="Bold" Margin="2,0,0,10"/>

        <UniformGrid Grid.Row="2" Rows="1" Columns="3" VerticalAlignment="Top">
            <Button Style="{StaticResource TileButton}" Click="GoIngameMarketInfo_Click" Margin="0,0,8,0">
                <StackPanel Margin="18,16">
                    <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{StaticResource AccentAmberBrush}"/>
                    <TextBlock Text="Oyun İçi Market" FontWeight="Bold" FontSize="15" Margin="0,10,0,2" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Market artık oyun içinde — Rotom Telefon/PC ile aç." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TileButton}" Click="GoReklam_Click" Margin="4,0,4,0">
                <StackPanel Margin="18,16">
                    <TextBlock Text="&#xE789;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{StaticResource AccentAmberBrush}"/>
                    <TextBlock Text="Duyurular" FontWeight="Bold" FontSize="15" Margin="0,10,0,2" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Etkinlikler, kampanyalar ve haberler." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TileButton}" Click="Discord_Click" Margin="8,0,0,0">
                <StackPanel Margin="18,16">
                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{StaticResource AccentAmberBrush}"/>
                    <TextBlock Text="Discord" FontWeight="Bold" FontSize="15" Margin="0,10,0,2" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Topluluğa katıl, çekilişleri kaçırma." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
