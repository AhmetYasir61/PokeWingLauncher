<Window x:Class="FWLauncherV2.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokeWingLauncher"
        Width="952"
        Height="616"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent">

    <!-- Drop shadow margin -->
    <Border Margin="16" CornerRadius="22" Background="{StaticResource WindowBackdrop}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.65"/>
        </Border.Effect>

        <Border CornerRadius="22" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===================== BRAND PANEL ===================== -->
                <Grid Grid.Column="0">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF0B1330" Offset="0"/>
                            <GradientStop Color="#FF130E2B" Offset="0.55"/>
                            <GradientStop Color="#FF1B0F2C" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- dekoratif parıltılar: altın (üst) + mavi kanat (sol alt) -->
                    <Ellipse Width="380" Height="380" HorizontalAlignment="Center" VerticalAlignment="Top"
                             Margin="0,-120,0,0" Opacity="0.5" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#66FFD21E" Offset="0"/>
                                <GradientStop Color="#22FF2E92" Offset="0.7"/>
                                <GradientStop Color="#00FF2E92" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-80,0,0,-90" Opacity="0.5" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#552F6BEE" Offset="0"/>
                                <GradientStop Color="#002F6BEE" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                        <Image Source="/PokeWingLauncher.png" Width="120" Height="120" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="36" ShadowDepth="0" Color="#FFFFD21E" Opacity="0.6"/>
                            </Image.Effect>
                        </Image>

                        <TextBlock Text="PokeWingLauncher" HorizontalAlignment="Center" Margin="0,22,0,0"
                                   FontSize="23" FontWeight="Bold" Foreground="White">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#FFFFD21E" Opacity="0.55"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <Border HorizontalAlignment="Center" Margin="0,14,0,0" CornerRadius="20"
                                Background="#22FFFFFF" Padding="14,6">
                            <TextBlock Text="PokeWing Network · NeoForge" Foreground="#FFFFE7A8" FontSize="12.5" FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock Text="Tek tıkla kur, oyna ve sunucuya otomatik bağlan."
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Width="240" Margin="0,18,0,0" Foreground="#AAFFFFFF" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- ===================== FORM PANEL ===================== -->
                <Grid Grid.Column="1" Background="{StaticResource WindowBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- top bar (drag + close) -->
                    <Grid Grid.Row="0" Background="Transparent" MouseDown="TopBar_MouseDown">
                        <Button Content="&#x2715;" Style="{StaticResource ChromeCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                Click="CloseButton_Click"/>
                    </Grid>

                    <!-- dynamic content (LoginView / RegisterView) -->
                    <ContentControl x:Name="ContentArea" Grid.Row="1"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
